<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
      BluetoothAudioRouter gates its API 31 implementation through an injected Platform
      API level so both modern and legacy paths can be tested on the JVM. Lint cannot
      infer that custom guard, but every framework API call remains isolated behind the
      API 31 platform implementation.
    -->
    <issue id="NewApi">
        <ignore path="src/main/java/com/whisperonnx/asr/BluetoothAudioRouter.java" />
    </issue>

    <!-- InputMethodService creates the IME root view; it has no parent ViewGroup to pass. -->
    <issue id="InflateParams">
        <ignore path="src/main/java/com/whisperonnx/WhisperInputMethodService.java" />
    </issue>

    <!-- voice_service.xml is an IME view, not an activity layout; the inferred theme is false. -->
    <issue id="Overdraw">
        <ignore path="src/main/res/layout/voice_service.xml" />
    </issue>
</lint>
