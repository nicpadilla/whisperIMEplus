<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <CheckBox
        android:id="@+id/replacement_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/replacement_enable_action" />

    <TextView
        android:id="@+id/tv_replacement_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="4dp"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/btn_edit_replacement"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="@string/replacement_edit_action" />

    <ImageButton
        android:id="@+id/btn_move_replacement_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:src="@android:drawable/arrow_up_float"
        android:contentDescription="@string/replacement_move_up_action" />

    <ImageButton
        android:id="@+id/btn_move_replacement_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="@string/replacement_move_down_action" />

    <ImageButton
        android:id="@+id/btn_delete_replacement"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="@string/replacement_delete_action" />
</LinearLayout>
